---
import { Image } from "astro:assets";

import logo from "@/images/logo.webp";
---

<header class="absolute top-0 w-max z-50 m-4 text-white">
    <!-- <a
        href=""
        class="block leading-none tracking-normal font-semibold mb-12 text-2xl"
    >
        KHU + LUGTU <br />
        <span class="text-base tracking-widest font-normal">DESIGN STUDIO</span>
    </a> -->

    <div class="max-w-60">
        <a href="">
            <Image
                src={logo}
                alt="Khu + Lugtu Design Studio Logo"
                class="block object-cover aspect-auto w-fit mb-8"
                draggable="false"
            />
        </a>

        <h1 class="w-fit mb-8 text-sm">
            An architectural design studio focused on creating calm, minimalist
            homes built for everyday living.
        </h1>

        <nav>
            <ul class="leading-tight group w-max uppercase space-y-4 text-sm">
                <li class="group-hover:opacity-60 hover:opacity-100 transition-opacity duration-300 ease-out tracking-[0.3em]">
                    <a href="/">Home</a>
                </li>
                <li class="group-hover:opacity-60 hover:opacity-100 transition-opacity duration-300 ease-out tracking-[0.3em]">
                    <a href="/works">Works</a>
                </li>
                <li class="group-hover:opacity-60 hover:opacity-100 transition-opacity duration-300 ease-out tracking-[0.3em]">
                    <a href="/">Studio</a>
                </li>
                <li class="group-hover:opacity-60 hover:opacity-100 transition-opacity duration-300 ease-out tracking-[0.3em]">
                    <a href="/">Contact</a>
                </li>
            </ul>
        </nav>
    </div>
</header>
