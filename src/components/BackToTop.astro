---
// No props needed, but you can make threshold configurable
const threshold = 300; // pixels scrolled before button appears
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="back-to-top"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
       fill="none" stroke="currentColor" stroke-width="2.5"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 50;

    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;

    border: none;
    border-radius: 9999px;
    background: white;
    color: #111;
    cursor: pointer;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);

    /* Hidden state */
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;

    /* Safe area for iOS notch devices */
    margin-bottom: env(safe-area-inset-bottom, 0);
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 0.2s ease, visibility 0.2s;
      transform: none;
    }
  }
</style>

<script>
  const THRESHOLD = 300; // must match the intent of the component; safe on all devices

  const button = document.getElementById('back-to-top');
  if (button) {
    let ticking = false;

    const toggleVisibility = () => {
      const scrolled = window.scrollY || document.documentElement.scrollTop;
      button.classList.toggle('is-visible', scrolled > THRESHOLD);
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(toggleVisibility);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    });

    // Sync on load (e.g., refreshed mid-page or bfcache restore)
    toggleVisibility();
    window.addEventListener('pageshow', toggleVisibility);
  }
</script>