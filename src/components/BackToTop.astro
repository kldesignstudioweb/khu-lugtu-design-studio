<button
  transition:persist
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 grid size-12 place-items-center rounded-full border-none bg-white p-0 text-[#111] opacity-0 invisible pointer-events-none cursor-pointer shadow-[0_4px_14px_rgb(0_0_0/0.15)] transition-[opacity,visibility] duration-250 ease-out motion-reduce:transform-none motion-reduce:transition-[opacity,visibility]"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>
<script>
  const init = () => {
    const button = document.getElementById("back-to-top");
    if (!(button instanceof HTMLButtonElement)) return;
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";
    const THRESHOLD = Number(button.dataset.threshold) || 300;
    let ticking = false;
    let rafId = 0;
    const show = () => {
      button.classList.remove(
        "opacity-0",
        "invisible",
        "pointer-events-none",
      );
      button.classList.add(
        "opacity-100",
        "visible",
        "pointer-events-auto",
      );
    };
    const hide = () => {
      button.classList.remove(
        "opacity-100",
        "visible",
        "pointer-events-auto",
      );
      button.classList.add(
        "opacity-0",
        "invisible",
        "pointer-events-none",
      );
    };
    const toggleVisibility = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      if (scrollTop > THRESHOLD) {
        show();
      } else {
        hide();
      }
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      rafId = requestAnimationFrame(toggleVisibility);
      ticking = true;
    };
    const onClick = () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("pageshow", toggleVisibility);
    button.addEventListener("click", onClick);
    toggleVisibility();
    const cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("pageshow", toggleVisibility);
      button.removeEventListener("click", onClick);
      cancelAnimationFrame(rafId);
      delete button.dataset.bound;
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>
