---
import { Image } from "astro:assets";
import logo from "@/images/logo.webp";
---

<section
  id="preloader"
  aria-hidden="true"
  class="preloader bg-black inset-0 h-svh w-svw fixed top-0 left-0 z-999 flex justify-center items-center overflow-hidden"
>
  <div class="p-16">
    <Image
      id="preloader-logo"
      src={logo}
      alt=""
      loading="eager"
      draggable="false"
      class="preloader-logo block max-h-16 w-max"
    />
  </div>
</section>

<style>
  .preloader-logo {
    opacity: 0;
  }

  .preloader.is-running .preloader-logo {
    animation:
      preloader-logo-in 1.5s ease-out forwards,
      preloader-logo-out 0.6s ease-in 1.8s forwards;
  }

  .preloader.is-running {
    animation: preloader-out 0.5s ease-in-out 2.4s forwards;
  }

  @keyframes preloader-logo-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes preloader-logo-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @keyframes preloader-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader,
    .preloader-logo {
      animation: none !important;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __preloaderShown?: boolean;
      __preloaderComplete?: boolean;
      __lenis?: {
        start: () => void;
        stop: () => void;
      };
    }
  }

  const PRELOADER_ID = "preloader";
  const COMPLETE_EVENT = "app:preloader-complete";
  const SCROLL_LOCK_CLASS = "preloader-scroll-locked";

  let originalOverflow: string | null = null;
  let originalScrollBehavior: string | null = null;
  let isScrollLocked = false;

  const lockScroll = (): void => {
    if (isScrollLocked) return;

    const root = document.documentElement;

    // Preserve existing inline styles rather than overwriting them permanently.
    originalOverflow = root.style.overflow;
    originalScrollBehavior = root.style.scrollBehavior;

    root.classList.add(SCROLL_LOCK_CLASS);
    root.style.overflow = "hidden";
    root.style.scrollBehavior = "auto";

    window.__lenis?.stop();

    isScrollLocked = true;
  };

  const unlockScroll = (): void => {
    if (!isScrollLocked) return;

    const root = document.documentElement;

    root.classList.remove(SCROLL_LOCK_CLASS);

    if (originalOverflow !== null) {
      root.style.overflow = originalOverflow;
    }

    if (originalScrollBehavior !== null) {
      root.style.scrollBehavior = originalScrollBehavior;
    }

    window.__lenis?.start();

    originalOverflow = null;
    originalScrollBehavior = null;
    isScrollLocked = false;
  };

  const signalComplete = (): void => {
    unlockScroll();

    if (window.__preloaderComplete) return;

    window.__preloaderComplete = true;
    window.dispatchEvent(new CustomEvent(COMPLETE_EVENT));
  };

  const removePreloader = (): void => {
    document.getElementById(PRELOADER_ID)?.remove();
    signalComplete();
  };

  const runPreloader = (): void => {
    const preloader = document.getElementById(PRELOADER_ID);

    if (!preloader) {
      signalComplete();
      return;
    }

    lockScroll();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      removePreloader();
      return;
    }

    const handleAnimationEnd = (event: AnimationEvent): void => {
      if (
        event.target !== preloader ||
        event.animationName !== "preloader-out"
      ) {
        return;
      }

      preloader.removeEventListener("animationend", handleAnimationEnd);

      removePreloader();
    };

    preloader.addEventListener("animationend", handleAnimationEnd);
    preloader.classList.add("is-running");
  };

  // Never show the initial-load preloader during client-side navigation.
  document.addEventListener("astro:before-swap", () => {
    unlockScroll();
  });

  document.addEventListener("astro:after-swap", () => {
    window.__preloaderShown = true;
    removePreloader();
  });

  document.addEventListener("astro:page-load", () => {
    if (window.__preloaderShown) {
      signalComplete();
      return;
    }

    window.__preloaderShown = true;
    runPreloader();
  });
</script>
