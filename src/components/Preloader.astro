---
import { Image } from "astro:assets";
import logo from "@/images/logo.webp";
---

<section
  id="preloader"
  aria-hidden="true"
  class="preloader bg-black inset-0 h-svh w-svw fixed top-0 left-0 z-999 flex justify-center items-center overflow-hidden"
>
  <div class="p-16">
    <Image
      id="preloader-logo"
      src={logo}
      alt=""
      loading="eager"
      draggable="false"
      class="preloader-logo block object-cover aspect-auto max-h-16 w-max"
    />
  </div>
</section>

<style>
  .preloader-logo {
    opacity: 0;
  }

  .preloader.is-running .preloader-logo {
    animation:
      preloader-logo-in 1.5s ease-out forwards,
      preloader-logo-out 0.6s ease-in 1.8s forwards;
  }

  .preloader.is-running {
    animation: preloader-out 0.5s ease-in-out 2.4s forwards;
  }

  @keyframes preloader-logo-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes preloader-logo-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @keyframes preloader-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader,
    .preloader-logo {
      animation: none !important;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __preloaderShown?: boolean;
      __preloaderComplete?: boolean;
    }
  }

  const PRELOADER_ID = "preloader";
  const COMPLETE_EVENT = "app:preloader-complete";

  const signalComplete = (): void => {
    if (window.__preloaderComplete) return;

    window.__preloaderComplete = true;
    window.dispatchEvent(new CustomEvent(COMPLETE_EVENT));
  };

  const removePreloader = (): void => {
    const preloader = document.getElementById(PRELOADER_ID);

    if (!preloader) {
      signalComplete();
      return;
    }

    preloader.remove();
    signalComplete();
  };

  const runPreloader = (): void => {
    const preloader = document.getElementById(PRELOADER_ID);

    if (!preloader) {
      signalComplete();
      return;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      removePreloader();
      return;
    }

    const handleAnimationEnd = (event: AnimationEvent): void => {
      if (event.animationName !== "preloader-out") return;

      preloader.removeEventListener("animationend", handleAnimationEnd);
      removePreloader();
    };

    preloader.addEventListener("animationend", handleAnimationEnd);

    preloader.classList.add("is-running");
  };

  // Astro client-side navigation:
  // the preloader must never run again during SPA navigation.
  document.addEventListener("astro:after-swap", () => {
    window.__preloaderShown = false;
    removePreloader();
  });

  document.addEventListener("astro:page-load", () => {
    if (window.__preloaderShown) {
      signalComplete();
      return;
    }

    window.__preloaderShown = true;
    runPreloader();
  });
</script>
