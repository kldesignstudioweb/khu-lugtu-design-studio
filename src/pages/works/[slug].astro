---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getAllWorks } from "@/lib/works";
import type { ResolvedWork } from "@/types/work";

export async function getStaticPaths() {
    const works = await getAllWorks();

    // No works → no pages. Prevents modulo-by-zero and empty builds.
    if (works.length === 0) return [];

    return works.map((work, i) => ({
        params: { slug: work.slug },
        props: {
            work,
            // Only assign a "next" when there is more than one work.
            // Otherwise the CTA would link to the current page.
            nextWork: works.length > 1 ? works[(i + 1) % works.length]! : null,
        },
    }));
}

interface Props {
    work: ResolvedWork;
    nextWork: ResolvedWork | null;
}

const { work, nextWork } = Astro.props;
const { title, year, category, description, coverImage, images } = work;

// Derive visual roles from data — never hardcode image indices.
const heroImage = coverImage;
const infoImage = images.find((img) => img.src !== coverImage.src);
const galleryImages = images.filter(
    (img) => img.src !== coverImage.src && img.src !== infoImage?.src,
);

// Responsive presets (shared, not duplicated on every <Image/>).
const fullBleed = { widths: [480, 800, 1280, 1920, 2560], sizes: "100vw" };
const halfWidth = {
    widths: [480, 800, 1280, 1920],
    sizes: "(min-width: 1024px) 50vw, 100vw",
};

// Grid rhythm: 2 side-by-side, then 1 full-width, repeating.
// If the final row would contain a single orphaned image, promote it to full-width.
const galleryCount = galleryImages.length;
const isWide = (i: number) =>
    (i + 1) % 3 === 0 || (i === galleryCount - 1 && galleryCount % 3 === 1);
---

<BaseLayout title={`Khu + Lugtu Design Studio | ${title}`}>
    <section class="min-h-svh space-y-2">
        {/* ---------- Hero ---------- */}
        <div class="h-svh relative">
            <Image
                src={heroImage}
                alt={`${title} — cover`}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="low-brightness"
                draggable="false"
                {...fullBleed}
            />
            <p class="uppercase absolute bottom-0 left-0 m-4 text-xl leading-none">
                {title}
            </p>
        </div>

        {/* ---------- Info ---------- */}
        <div class="h-svh relative">
            {infoImage && (
                <Image
                    src={infoImage}
                    alt={`${title} — interior view`}
                    loading="lazy"
                    decoding="async"
                    class="low-brightness"
                    draggable="false"
                    {...fullBleed}
                />
            )}

            <div class="absolute top-0 left-0 m-4">
                <p class="max-w-sm text-balance mb-8">{description}</p>

                <div class="space-y-4">
                    <div>
                        <p>Year</p>
                        <p class="text-muted">{year}</p>
                    </div>
                    <div>
                        <p>Type</p>
                        <p class="text-muted">{category}</p>
                    </div>
                </div>
            </div>
        </div>

        {/* ---------- Gallery ---------- */}
        {galleryImages.length > 0 && (
            <div class="grid lg:grid-cols-2 gap-2">
                {galleryImages.map((img, i) => (
                    <Image
                        src={img}
                        alt={`${title} — image ${i + 1}`}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        class:list={[
                            "h-svh low-brightness",
                            isWide(i) && "lg:col-span-2",
                        ]}
                        {...halfWidth}
                    />
                ))}
            </div>
        )}

        {/* ---------- Outro: next work + back link ---------- */}
        <div class="h-svh relative">
            <Image
                src={nextWork?.coverImage ?? coverImage}
                alt={
                    nextWork ? `${nextWork.title} — cover` : `${title} — cover`
                }
                loading="lazy"
                decoding="async"
                draggable="false"
                class="low-brightness"
                {...fullBleed}
            />

            <div class="flex flex-col justify-between items-center text-center size-full absolute top-0 py-4">
                {nextWork ? (
                    <a href={`/works/${nextWork.slug}`} class="text-sm">
                        ( View next work )
                    </a>
                ) : (
                    <span aria-hidden="true"></span>
                )}

                {nextWork && (
                    <a
                        href={`/works/${nextWork.slug}`}
                        class="text-xl! max-w-lg leading-none tracking-tight uppercase"
                    >
                        {nextWork.title}
                    </a>
                )}

                <a href="/works" class="text-sm">
                    ( Go back to all works )
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
