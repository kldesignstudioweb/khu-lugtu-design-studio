---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
    getAllWorks,
    getWorkBySlug,
} from "@/lib/works";
import type { ResolvedWork } from "@/types/work";

const slug = Astro.params.slug;

if (!slug) {
    return new Response("Work slug is required.", {
        status: 400,
        statusText: "Bad Request",
    });
}

const work = await getWorkBySlug(slug);

if (!work) {
    return new Response("Work not found.", {
        status: 404,
        statusText: "Not Found",
    });
}

const works = await getAllWorks();

const currentIndex = works.findIndex(
    (item) => item.slug === work.slug,
);

const nextWork: ResolvedWork | null =
    works.length > 1 && currentIndex !== -1
        ? works[(currentIndex + 1) % works.length] ?? null
        : null;

const {
    title,
    year,
    category,
    description,
    coverImage,
    images,
} = work;

// Derive visual roles from data — never hardcode image indices.
const heroImage = coverImage;

const infoImage = images.find(
    (img) => img.src !== coverImage.src,
);

const galleryImages = images.filter(
    (img) =>
        img.src !== coverImage.src &&
        img.src !== infoImage?.src,
);

// Responsive presets (shared, not duplicated on every <Image/>).
const fullBleed = {
    widths: [480, 800, 1280, 1920, 2560],
    sizes: "100vw",
};

const halfWidth = {
    widths: [480, 800, 1280, 1920],
    sizes: "(min-width: 1024px) 50vw, 100vw",
};

// Grid rhythm: 2 side-by-side, then 1 full-width, repeating.
// If the final row would contain a single orphaned image,
// promote it to full-width.
const galleryCount = galleryImages.length;

const isWide = (i: number) =>
    (i + 1) % 3 === 0 ||
    (i === galleryCount - 1 && galleryCount % 3 === 1);
---

<BaseLayout title={`Khu + Lugtu Design Studio | ${title}`} description={`${description}`}>
    <section class="min-h-svh space-y-2">
        {/* ---------- Hero ---------- */}
        <div class="h-svh relative">
            <Image
                src={heroImage}
                alt={`${title} — cover`}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="low-brightness aspect-auto"
                draggable="false"
                {...fullBleed}
            />

            <p
                class="uppercase absolute bottom-0 left-0 m-4 text-lg md:text-xl leading-none"
            >
                {title}
            </p>
        </div>

        {/* ---------- Info ---------- */}
        <div class="h-[80svh] lg:h-svh relative m-2">
          {infoImage && (
              <button
                  type="button"
                  class="lightbox-trigger size-full"
                  data-lightbox-trigger
                  aria-label={`Open ${title} — interior view`}
              >
                  <Image
                      src={infoImage}
                      alt={`${title} — interior view`}
                      loading="lazy"
                      decoding="async"
                      class="low-brightness rounded-lg aspect-auto size-full object-cover"
                      draggable="false"
                      {...fullBleed}
                  />
              </button>
          )}

            <div class="absolute top-0 left-0 m-4">
                <p class="max-w-sm text-balance mb-8">
                    {description}
                </p>

                <div class="space-y-4">
                    <div>
                        <p>Year</p>
                        <p class="text-muted">{year}</p>
                    </div>

                    <div>
                        <p>Type</p>
                        <p class="text-muted">{category}</p>
                    </div>
                </div>
            </div>
        </div>

        {/* ---------- Gallery ---------- */}
        {galleryImages.length > 0 && (
            <div class="grid lg:grid-cols-2 gap-2 m-2">
              {galleryImages.map((img, i) => (
                  <button
                      type="button"
                      class:list={[
                          "lightbox-trigger",
                          isWide(i) && "lg:col-span-2",
                      ]}
                      data-lightbox-trigger
                      aria-label={`Open ${title} — image ${i + 1}`}
                  >
                      <Image
                          src={img}
                          alt={`${title} — image ${i + 1}`}
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                          class="h-[80svh] lg:h-svh low-brightness rounded-lg aspect-auto size-full object-cover"
                          {...halfWidth}
                      />
                  </button>
              ))}
            </div>
        )}

        <dialog
            id="image-lightbox"
            aria-label="Image preview"
            class="m-0 size-full max-h-none max-w-none p-2 bg-black/50 backdrop-blur-md"
        >
            <div
                class="relative flex size-full items-center justify-center p-2"
                data-lightbox-surface
            >
                <button
                    type="button"
                    data-lightbox-close
                    class="absolute right-0 top-0 z-10 text-sm text-white"
                    aria-label="Close image preview"
                >
                    ( Close )
                </button>
        
                <img
                    id="lightbox-image"
                    src=""
                    alt=""
                    class="max-h-full max-w-full object-contain"
                    draggable="false"
                />
            </div>
        </dialog>

        {/* ---------- Outro: next work + back link ---------- */}
        <div class="h-[calc(100svh-1rem)] relative m-2">
            <Image
                src={nextWork?.coverImage ?? coverImage}
                alt={
                    nextWork
                        ? `${nextWork.title} — cover`
                        : `${title} — cover`
                }
                loading="lazy"
                decoding="async"
                draggable="false"
                class="low-brightness rounded-lg"
                {...fullBleed}
            />

            <div
                class="flex flex-col justify-between items-center text-center size-full absolute top-0 py-4"
            >
                {nextWork ? (
                    <a
                        href={`/works/${nextWork.slug}`}
                        class="text-sm"
                    >
                        ( View next work )
                    </a>
                ) : (
                    <span aria-hidden="true"></span>
                )}

                {nextWork && (
                    <a
                        href={`/works/${nextWork.slug}`}
                        class="text-lg max-w-xs md:text-xl md:max-w-lg leading-none tracking-tight uppercase"
                    >
                        {nextWork.title}
                    </a>
                )}

                <a href="/works" class="text-sm">
                    ( Go back to all works )
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    type LenisController = {
        stop: () => void;
        start: () => void;
    };

    let cleanupLightbox: (() => void) | null = null;

    const initLightbox = () => {
        // Always clean up the previous page's instance first.
        cleanupLightbox?.();
        cleanupLightbox = null;

        const mobileMedia = window.matchMedia("(max-width: 767px)");

        // Do not initialize the lightbox on iPad or larger screens.
        if (!mobileMedia.matches) return;

        const dialog = document.querySelector<HTMLDialogElement>(
            "#image-lightbox",
        );
        const lightboxImage = document.querySelector<HTMLImageElement>(
            "#lightbox-image",
        );
        const surface = document.querySelector<HTMLElement>(
            "[data-lightbox-surface]",
        );
        const closeButton = document.querySelector<HTMLButtonElement>(
            "[data-lightbox-close]",
        );

        if (!dialog || !lightboxImage || !surface || !closeButton) return;

        const triggers = Array.from(
            document.querySelectorAll<HTMLButtonElement>(
                "[data-lightbox-trigger]",
            ),
        );

        if (!triggers.length) return;

        const lenis = (
            window as typeof window & {
                __lenis?: LenisController;
            }
        ).__lenis;

        let currentIndex = 0;
        let touchStartX = 0;
        let ignoreNextClick = false;
        let scrollLocked = false;

        const previousHtmlOverflow =
            document.documentElement.style.overflow;
        const previousBodyOverflow = document.body.style.overflow;

        const lockScroll = () => {
            if (scrollLocked) return;

            document.documentElement.style.overflow = "hidden";
            document.body.style.overflow = "hidden";

            lenis?.stop();

            scrollLocked = true;
        };

        const unlockScroll = () => {
            if (!scrollLocked) return;

            if (previousHtmlOverflow) {
                document.documentElement.style.overflow =
                    previousHtmlOverflow;
            } else {
                document.documentElement.style.removeProperty("overflow");
            }

            if (previousBodyOverflow) {
                document.body.style.overflow = previousBodyOverflow;
            } else {
                document.body.style.removeProperty("overflow");
            }

            lenis?.start();

            scrollLocked = false;
        };

        const showImage = (index: number) => {
            const trigger = triggers[index];

            if (!trigger) return;

            const image = trigger.querySelector<HTMLImageElement>("img");

            if (!image) return;

            currentIndex = index;
            lightboxImage.src = image.currentSrc || image.src;
            lightboxImage.alt = image.alt;
        };

        const closeLightbox = () => {
            if (!dialog.open) return;

            dialog.close();
        };

        const showPrevious = () => {
            showImage(
                (currentIndex - 1 + triggers.length) % triggers.length,
            );
        };

        const showNext = () => {
            showImage((currentIndex + 1) % triggers.length);
        };

        const openLightbox = (event: Event) => {
            if (!mobileMedia.matches || dialog.open) return;

            const trigger = event.currentTarget as HTMLButtonElement;
            const index = triggers.indexOf(trigger);

            if (index === -1) return;

            showImage(index);
            dialog.showModal();
            lockScroll();
        };

        const handleDialogClose = () => {
            unlockScroll();

            lightboxImage.src = "";
            lightboxImage.alt = "";
        };

        const handleSurfaceClick = (event: MouseEvent) => {
            if (ignoreNextClick) {
                ignoreNextClick = false;
                return;
            }

            if (
                event.target instanceof Element &&
                event.target.closest("[data-lightbox-close]")
            ) {
                return;
            }

            if (!mobileMedia.matches || !dialog.open) return;

            const midpoint = window.innerWidth / 2;

            if (event.clientX < midpoint) {
                showPrevious();
            } else {
                showNext();
            }
        };

        const handleTouchStart = (event: TouchEvent) => {
            if (!mobileMedia.matches || !dialog.open) return;

            const touch = event.changedTouches[0];

            if (!touch) return;

            touchStartX = touch.clientX;
        };

        const handleTouchEnd = (event: TouchEvent) => {
            if (!mobileMedia.matches || !dialog.open) return;

            const touch = event.changedTouches[0];

            if (!touch) return;

            const distance = touch.clientX - touchStartX;

            if (Math.abs(distance) < 40) return;

            // Prevent the synthetic click that can follow a swipe
            // from navigating to another image a second time.
            ignoreNextClick = true;

            if (distance < 0) {
                showNext();
            } else {
                showPrevious();
            }
        };

        const handleMediaChange = (event: MediaQueryListEvent) => {
            if (!event.matches && dialog.open) {
                closeLightbox();
            }
        };

        triggers.forEach((trigger) => {
            trigger.addEventListener("click", openLightbox);
        });

        closeButton.addEventListener("click", closeLightbox);
        surface.addEventListener("click", handleSurfaceClick);
        surface.addEventListener("touchstart", handleTouchStart, {
            passive: true,
        });
        surface.addEventListener("touchend", handleTouchEnd, {
            passive: true,
        });

        dialog.addEventListener("close", handleDialogClose);
        mobileMedia.addEventListener("change", handleMediaChange);

        cleanupLightbox = () => {
            triggers.forEach((trigger) => {
                trigger.removeEventListener("click", openLightbox);
            });

            closeButton.removeEventListener("click", closeLightbox);
            surface.removeEventListener("click", handleSurfaceClick);
            surface.removeEventListener("touchstart", handleTouchStart);
            surface.removeEventListener("touchend", handleTouchEnd);

            dialog.removeEventListener("close", handleDialogClose);
            mobileMedia.removeEventListener("change", handleMediaChange);

            if (dialog.open) {
                dialog.close();
            }

            unlockScroll();
        };
    };

    document.addEventListener("astro:page-load", initLightbox);

    document.addEventListener("astro:before-swap", () => {
        cleanupLightbox?.();
        cleanupLightbox = null;
    });
</script>

<style>
    #image-lightbox {
        overscroll-behavior: contain;
        touch-action: pan-y;
    }

    @media (min-width: 768px) {
        #image-lightbox {
            display: none;
        }
    }
</style>