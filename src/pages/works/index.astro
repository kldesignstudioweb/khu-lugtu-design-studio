---
// src/pages/works/index.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTA from "@/components/CTA.astro";

import { Image } from "astro:assets";
import { getAllWorks } from "@/lib/works";

const works = await getAllWorks();

// First work becomes the full-width hero.
// The rest flow into the 12-column grid as half-width cards.
const [heroWork, ...gridWorks] = works;
---

<BaseLayout
  title="Khu + Lugtu Design Studio | Architectural Works & Projects"
  description="Explore selected residential and commercial projects by Khu + Lugtu Design Studio, featuring thoughtful architectural design with a focus on minimalism, materiality, and space."
>
  <main class="min-h-svh relative mt-[50svh]">
    {works.length > 0 ? (
      <div class="grid grid-cols-12 gap-2 m-2">
        {heroWork && (
          <article class="col-span-12 overflow-hidden">
            <a href={`/works/${heroWork.slug}`} class="group block relative">
              <Image
                src={heroWork.coverImage}
                alt={`${heroWork.title} — ${heroWork.category}, ${heroWork.year}`}
                class="low-brightness h-[80svh] lg:h-svh rounded-lg"
                layout="full-width"
                sizes="100vw"
                fit="cover"
                position="center"
                quality="high"
                loading="eager"
                draggable="false"
                title="View Project"
              />
              <h1 class="leading-none m-4 absolute top-0 left-0">
                Selected Works
              </h1>

              <div class="mt-2 absolute bottom-0 left-0 m-4">
                <h2>{heroWork.title}</h2>
                <p class="max-w-prose">{heroWork.description}</p>
              </div>
            </a>
          </article>
        )}

        {gridWorks.map((work) => (
          <article class="col-span-12">
            <a href={`/works/${work.slug}`} class="group block relative">
              <Image
                src={work.coverImage}
                alt={`${work.title} — ${work.category}, ${work.year}`}
                class="low-brightness h-[80svh] lg:h-svh rounded-lg"
                layout="full-width"
                sizes="100vw"
                fit="cover"
                position="center"
                quality="high"
                loading="lazy"
                draggable="false"
                title="View Project"
              />
              <div class="absolute bottom-0 left-0 m-4">
                <h2>{work.title}</h2>
                <p class="max-w-prose">{work.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="p-4 text-muted">No works found.</p>
    )}

    <CTA />
  </main>
</BaseLayout>
