---
import { Image } from "astro:assets";
import { getFeaturedWorks } from "@/lib/works";

const featured = await getFeaturedWorks();
const count = String(featured.length).padStart(2, "0");
---

<section class="min-h-svh text-white">
    <div class="relative">
        <div class="absolute top-4 left-4 z-10">
            <h2>Featured Works ({count})</h2>
            <p class="text-muted">Click image to view</p>
        </div>

        <div class="swiper featured-works">
            <div class="swiper-wrapper">
                {featured.map((work, i) => (
                    <div class="swiper-slide">
                        <a
                            href={`/works/${work.slug}`}
                            class="relative block h-svh"
                        >
                            <Image
                                src={work.coverImage}
                                alt={work.title}
                                widths={[640, 1024, 1600]}
                                sizes="90svw"
                                class="h-svh w-full object-cover low-brightness"
                                loading={i === 0 ? "eager" : "lazy"}
                                fetchpriority={i === 0 ? "high" : "auto"}
                                draggable="false"
                            />

                            <h3 class="absolute bottom-4 left-4 text-lg! leading-none lg:text-xl!">
                                {work.title}
                            </h3>
                        </a>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .featured-works .swiper-slide {
        width: 95svw;
    }
</style>

<script>
    import Swiper from "swiper";
    import "swiper/css";

    new Swiper(".featured-works", {
        slidesPerView: "auto",
        centeredSlides: true,
        centeredSlidesBounds: true,
        spaceBetween: 8,
        grabCursor: true,
        speed: 800,
    });
</script>
