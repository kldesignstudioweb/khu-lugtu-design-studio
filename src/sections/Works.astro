---
import { Image } from "astro:assets";
import { getFeaturedWorks } from "@/lib/works";

const featured = await getFeaturedWorks();
const count = String(featured.length).padStart(2, "0");
---

<section class="h-svh text-white m-2">
  <div class="relative">
    <div class="absolute top-4 left-4 z-10">
      <h2>Featured Works ({count})</h2>
      <p class="text-muted">Drag left/right to view</p>
    </div>

    <div class="featured-works overflow-hidden">
      <div class="featured-works__track flex gap-2 cursor-grab">
        {featured.map((work) => (
          <div class="featured-works__slide shrink-0">
            <a href={`/works/${work.slug}`} class="relative block h-svh">
              <Image
                src={work.coverImage}
                alt={work.title}
                class="low-brightness"
                loading="lazy"
                draggable="false"
              />

              <h3 class="absolute bottom-0 left-0 m-4 lg:text-xl leading-none uppercase">
                {work.title}
              </h3>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .featured-works__slide {
    width: 90svw;
  }

  .featured-works__track {
    will-change: transform;
  }

  .featured-works__track.is-dragging {
    cursor: grabbing;
  }
</style>

<script>
  import gsap from "gsap";
  import { Draggable } from "gsap/Draggable";
  import { InertiaPlugin } from "gsap/InertiaPlugin";

  gsap.registerPlugin(Draggable, InertiaPlugin);

  let cleanup: (() => void) | undefined;

  function destroyFeaturedWorks() {
    cleanup?.();
    cleanup = undefined;

    // Kill any lingering Draggable on either track (handles swapped DOM)
    document
      .querySelectorAll<HTMLElement>(".featured-works__track")
      .forEach((el) => Draggable.get(el)?.kill());
  }

  function initFeaturedWorks() {
    // Always clean up first — prevents duplicates across HMR / repeat events
    destroyFeaturedWorks();

    const track = document.querySelector<HTMLElement>(".featured-works__track");
    const container = document.querySelector<HTMLElement>(".featured-works");
    if (!track || !container) return;

    const getBounds = () => ({
      minX: container.offsetWidth - track.scrollWidth,
      maxX: 0,
    });

    const { minX, maxX } = getBounds();

    const instance = Draggable.create(track, {
      type: "x",
      bounds: { minX, maxX },
      inertia: true,
      cursor: "grab",
      activeCursor: "grabbing",
      edgeResistance: 0.85,
      dragResistance: 0,
      allowContextMenu: true,
      onPress() {
        track.classList.add("is-dragging");
      },
      onRelease() {
        track.classList.remove("is-dragging");
      },
      onDragStart() {
        track.style.pointerEvents = "none";
      },
      onDragEnd() {
        track.style.pointerEvents = "";
      },
    })[0];

    const onResize = () => {
      if (!instance) return;
      instance.applyBounds(getBounds());
    };

    // Recalc once images have loaded (SVW widths + lazy images shift scrollWidth)
    const onLoad = () => instance?.applyBounds(getBounds());
    track.querySelectorAll("img").forEach((img) => {
      if (!img.complete) img.addEventListener("load", onLoad, { once: true });
    });

    // ResizeObserver is more robust than window resize for layout-driven bounds
    const ro = new ResizeObserver(onResize);
    ro.observe(container);
    ro.observe(track);

    window.addEventListener("resize", onResize);

    cleanup = () => {
      instance?.kill();
      ro.disconnect();
      window.removeEventListener("resize", onResize);
    };
  }

  initFeaturedWorks();

  document.addEventListener("astro:page-load", initFeaturedWorks);
  document.addEventListener("astro:before-swap", destroyFeaturedWorks);
</script>