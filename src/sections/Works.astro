---
import { Image } from "astro:assets";
import { getFeaturedWorks } from "@/lib/works";

const featured = await getFeaturedWorks();
const count = String(featured.length).padStart(2, "0");
---

<section class="min-h-svh text-white m-2">
  <div class="relative">
    <div class="absolute top-4 left-4 z-10">
      <h2>Featured Works ({count})</h2>
      <p class="hidden md:block text-muted">Drag or swipe left/right to view</p>
    </div>

    <div class="featured-works overflow-hidden rounded-lg">
      <div class="featured-works__track flex flex-col md:flex-row gap-2 cursor-grab will-change-transform">
        {featured.map((work) => (
          <div class="featured-works__slide shrink-0 md:w-[90svw]">
            <a href={`/works/${work.slug}`} class="relative block h-[80svh] md:h-svh">
              <Image
                src={work.coverImage}
                alt={work.title}
                class="low-brightness rounded-lg"
                loading="lazy"
                draggable="false"
              />

              <h3 class="absolute bottom-0 left-0 m-4 text-lg md:text-xl leading-none uppercase">
                {work.title}
              </h3>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { Draggable } from "gsap/Draggable";
  import { InertiaPlugin } from "gsap/InertiaPlugin";

  gsap.registerPlugin(Draggable, InertiaPlugin);

  interface Bounds {
    minX: number;
    maxX: number;
  }

  let cleanup: (() => void) | undefined;

  function destroyFeaturedWorks(): void {
    cleanup?.();
    cleanup = undefined;

    document
      .querySelectorAll<HTMLElement>(".featured-works__track")
      .forEach((el: HTMLElement) => Draggable.get(el)?.kill());
  }

  function initFeaturedWorks(): void {
    destroyFeaturedWorks();

    const track = document.querySelector<HTMLElement>(".featured-works__track");
    const container = document.querySelector<HTMLElement>(".featured-works");

    if (!track || !container) return;

    let currentX = 0;
    let bounds: Bounds = { minX: 0, maxX: 0 };
    let isDragging = false;

    const getBounds = (): Bounds => ({
      minX: container.offsetWidth - track.scrollWidth,
      maxX: 0,
    });

    bounds = getBounds();

    // Clamp utility to keep translation within bounds
    const clampX = (val: number): number =>
      Math.max(bounds.minX, Math.min(bounds.maxX, val));

    // Syncs internal state with Draggable's actual transform (e.g., after inertia ends)
    const syncStateFromDraggable = (): void => {
      const draggableInstance = Draggable.get(track);
      if (draggableInstance) {
        currentX = draggableInstance.x;
      }
    };

    const instance = Draggable.create(track, {
      type: "x",
      bounds: { minX: bounds.minX, maxX: bounds.maxX },
      inertia: true,
      cursor: "grab",
      activeCursor: "grabbing",
      edgeResistance: 0.85,
      dragResistance: 0,
      allowContextMenu: true,
      onPress() {
        isDragging = true;
        track.classList.add("is-dragging");
      },
      onRelease() {
        isDragging = false;
        track.classList.remove("is-dragging");
      },
      onDragStart() {
        track.style.pointerEvents = "none";
      },
      onDragEnd() {
        track.style.pointerEvents = "";
        syncStateFromDraggable();
      },
      onThrowComplete() {
        syncStateFromDraggable();
      },
    })[0];

    // Touchpad / Mouse Wheel Support
    const handleWheel = (e: WheelEvent): void => {
      // Only intercept horizontal gestures (touchpad swipe)
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;

      e.preventDefault();

      // If user touches touchpad while GSAP inertia/drag is running, kill it to take manual control
      if (instance.isDragging || instance.isThrowing) {
        instance.endDrag();
        gsap.killTweensOf(track);
      }

      currentX = clampX(currentX - e.deltaX);

      // Apply directly without animation for 1:1 touchpad tracking feel
      gsap.set(track, { x: currentX });
    };

    // Passive: false is strictly required to allow preventDefault on wheel events
    container.addEventListener("wheel", handleWheel, { passive: false });

    const onResize = (): void => {
      bounds = getBounds();
      instance.applyBounds({ minX: bounds.minX, maxX: bounds.maxX });

      // Re-clamp current position if viewport shrank
      currentX = clampX(currentX);
      gsap.set(track, { x: currentX });
    };

    const onLoad = (): void => {
      bounds = getBounds();
      instance.applyBounds({ minX: bounds.minX, maxX: bounds.maxX });
    };

    track
      .querySelectorAll<HTMLImageElement>("img")
      .forEach((img: HTMLImageElement) => {
        if (!img.complete) img.addEventListener("load", onLoad, { once: true });
      });

    const ro = new ResizeObserver(onResize);
    ro.observe(container);
    ro.observe(track);

    window.addEventListener("resize", onResize);

    cleanup = () => {
      instance.kill();
      ro.disconnect();
      container.removeEventListener("wheel", handleWheel);
      window.removeEventListener("resize", onResize);
    };
  }

  initFeaturedWorks();

  document.addEventListener("astro:page-load", initFeaturedWorks);
  document.addEventListener("astro:before-swap", destroyFeaturedWorks);
</script>
