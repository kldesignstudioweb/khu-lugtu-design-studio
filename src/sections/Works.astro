---
import { Image } from "astro:assets";
import { getFeaturedWorks } from "@/lib/works";

/**
 * Horizontally scrollable showcase of featured works.
 * Data source: `getFeaturedWorks()` — images are already resolved
 * to `ImageMetadata` and safe to pass straight to `<Image />`.
 */
const featured = await getFeaturedWorks();
const count = String(featured.length).padStart(2, "0");
---

<section class="min-h-svh text-white">
  <div class="relative">
    <div class="absolute top-4 left-4 z-10">
      <h2>Featured Works ({count})</h2>
      <p class="text-muted">Click image to view</p>
    </div>

    <div class="flex gap-2 overflow-x-scroll snap-x snap-mandatory">
      {featured.map((work, i) => (
        <div>
          <a href={`/works/${work.slug}`} class="relative block snap-center">
            <Image
              src={work.coverImage}
              alt={work.title}
              widths={[640, 1024, 1600]}
              sizes="90svw"
              class="min-w-[90svw] h-svh object-cover low-brightness"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              draggable="false"
            />
            <h3 class="absolute bottom-4 left-4 text-lg! lg:text-xl! leading-none">
              {work.title}
            </h3>
          </a>
        </div>
      ))}

      <div class="min-w-[20svw] flex justify-center items-center snap-end">
        <a href="/works" class="text-center">( View All Works )</a>
      </div>
    </div>
  </div>
</section>