---
import { Image } from "astro:assets";
import { getFeaturedWorks } from "@/lib/works";

const featured = await getFeaturedWorks();
const count = String(featured.length).padStart(2, "0");
---

<section class="h-svh text-white m-2">
  <div class="relative">
    <div class="absolute top-4 left-4 z-10">
      <h2>Featured Works ({count})</h2>
      <p class="text-muted">Drag left/right to view</p>
    </div>

    <div class="swiper featured-works">
      <div class="swiper-wrapper">
        {featured.map((work, i) => (
          <div class="swiper-slide">
            <a href={`/works/${work.slug}`} class="relative block h-svh">
              <Image
                src={work.coverImage}
                alt={work.title}
                class="low-brightness"
                loading="lazy"
                draggable="false"
              />

              <h3 class="absolute bottom-0 left-0 m-4 text-xl leading-none uppercase">
                {work.title}
              </h3>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .featured-works .swiper-slide {
    width: 90svw;
  }
</style>

<script>
  import Swiper from "swiper";
  import "swiper/css";

  new Swiper(".featured-works", {
    slidesPerView: "auto",
    spaceBetween: 8,
    grabCursor: true,
    speed: 800,
  });
</script>
