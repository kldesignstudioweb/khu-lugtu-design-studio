---
import { Image } from "astro:assets";
import serviceImg1 from "@/images/pocket-house/pocket-house-3.webp";
import serviceImg2 from "@/images/pocket-house/pocket-house-9.webp";
---

<section class="min-h-svh m-2">
  <div class="grid lg:grid-cols-2 gap-2">
    <div class="relative">
      <h2 class="absolute top-4 left-4 z-10">Our Services</h2>
      <Image
        src={serviceImg1}
        alt="pocket-house-entry-way"
        loading="lazy"
        class="h-[80svh] lg:h-svh low-brightness rounded-lg"
      />
      <div class="absolute bottom-0 left-0 m-4">
        <h3 class="text-lg mb-2">Architectural Design</h3>
        <p class="mb-8 max-w-md text-muted">
          From new homes to transformations of existing spaces, we design
          residences around their context, occupants, and way of living.
        </p>

        <button
          type="button"
          data-contact-open
          class="cursor-pointer"
        >
          ( Inquire service )
        </button>
      </div>
    </div>
    <div class="relative">
      <Image
        src={serviceImg2}
        alt="pocket-house-bedroom"
        loading="lazy"
        class="h-[80svh] lg:h-svh low-brightness rounded-lg"
      />
      <div class="absolute bottom-0 left-0 m-4">
        <h3 class="text-lg mb-2">Design Consultancy</h3>
        <p class="mb-8 max-w-md text-muted">
          We create commercial environments that balance practical requirements
          with a clear architectural identity and thoughtful experience.
        </p>

        <button
          type="button"
          data-contact-open
          class="cursor-pointer"
        >
          ( Inquire service )
        </button>
      </div>
    </div>
  </div>
</section>
