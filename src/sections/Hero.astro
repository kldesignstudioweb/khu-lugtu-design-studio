---
import { Image } from "astro:assets";

import heroImg from "@/images/go-residence/go-residence-3.webp";
---

<section class="h-svh relative text-white">
    <Image
        src={heroImg}
        alt="go-residence-living-room"
        loading="eager"
        fetchpriority="high"
        class="low-brightness"
    />
    <h1 class="absolute bottom-0 m-4 max-w-sm">
        An architectural design studio focused on creating calm, minimalist
        homes built for everyday living.
    </h1>
</section>
